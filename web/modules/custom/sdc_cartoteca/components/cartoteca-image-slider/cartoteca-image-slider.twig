{#
  Componente: cartoteca-image-slider
  Props:
    url           — URL de la API. El JS fetcha y renderiza al recibir cartoteca:load.
    default_image — Imagen mostrada en estado inicial o sin resultados.
#}
{% set imgSrc = default_image is not empty ? default_image : '' %}

<div {{ attributes.addClass('sdc-cartoteca__slider', 'card', 'h-100') }}
     data-cartoteca-url="{{ url ?? '' }}"
     data-cartoteca-default="{{ imgSrc }}">

  <h2 class="sdc-cartoteca__slider-title card-header h6 mb-0">
    {{ 'Imágenes del mapa'|t }}
  </h2>

  <div class="sdc-cartoteca__slider-body">
    <div class="sdc-cartoteca__stage position-relative">
      <div class="sdc-cartoteca__slide"
           data-slide-index="0"
           data-sizes="{}">
        <img
          src="{{ imgSrc }}"
          alt="{{ 'Imagen no disponible'|t }}"
          class="sdc-cartoteca__image card-img-top img-fluid"
          loading="lazy"
        />
      </div>
    </div>
  </div>

</div>
