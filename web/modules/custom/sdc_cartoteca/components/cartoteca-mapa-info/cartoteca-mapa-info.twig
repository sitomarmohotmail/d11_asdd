{#
  Componente: cartoteca-mapa-info
  Props:
    url — URL de la API. El JS fetcha y renderiza al recibir cartoteca:load.
#}
<div {{ attributes.addClass('sdc-cartoteca__info', 'card', 'h-100') }}
     data-cartoteca-url="{{ url ?? '' }}">

  <h2 class="sdc-cartoteca__info-title card-header h6 mb-0">
    {{ 'Datos del mapa'|t }}
  </h2>

  <div class="sdc-cartoteca__info-body">
    <div class="card-body">
      <p class="sdc-cartoteca__message text-center text-muted fst-italic mb-0">
        {{ 'Esperando selección'|t }}
      </p>
    </div>
  </div>

</div>
